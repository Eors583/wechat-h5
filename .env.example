# Create a form at https://web3forms.com and bind it to the notification inbox.
WEB3FORMS_ACCESS_KEY=replace_with_your_form_access_key

# Persistent SQLite database path. Keep this directory on a Docker volume in production.
DATABASE_PATH=./data/leads.sqlite
DATABASE_MIGRATIONS_PATH=./drizzle

# Public HTTPS origin used by the deployment documentation and origin checks.
PUBLIC_BASE_URL=https://course.example.com

HOST=0.0.0.0
PORT=3000
